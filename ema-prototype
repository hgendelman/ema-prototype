    +'<div class="page-sub">Past residents only. Approved → Bad Debt GL. Balances $50+ sent to collections.</div>'
    +'<div class="stat-grid">'
    +'<div class="stat"><div class="stat-lbl">Total write-offs</div><div class="stat-val warn">'+fmt(tot)+'</div></div>'
    +'<div class="stat"><div class="stat-lbl">To collections</div><div class="stat-val warn">'+MO.filter(r=>r.total>50).length+' items</div></div>'
    +'</div>'
    +'<div class="tbl-wrap">'+rows+'</div>'
    +navRow('Continue to attestation →',true,false)
    +'</div>';
}

// ── ATTESTATION ──
function attestPage(){
  const totAR=RES.reduce((s,r)=>s+r.ar0+r.ar30+r.ar60+r.ar90,0);
  const totCr=RES.filter(r=>r.credit>0&&!crFlagged[r.id]).reduce((s,r)=>s+r.credit,0);
  const totWO=MO.filter(r=>woD[r.id]===true).reduce((s,r)=>s+r.total,0);
  const totPP=RES.filter(r=>r.prepay>0&&r.credit===0).reduce((s,r)=>s+r.prepay,0)+totCr;
  const summaryRows=[
    ['Total AR outstanding',fmt(totAR),'var(--roots)'],
    ['Credits converted to prepayments',fmt(totCr),'var(--ocean)'],
    ['Total prepayments rolling over',fmt(totPP),'#155724'],
    ['Write-offs to Bad Debt GL',fmt(totWO),'var(--roots)'],
  ];
  return '<div>'
    +'<div class="eyebrow">Step 5 of 5 · General Manager attestation</div>'
    +'<div class="page-title">Sign off on August 2026 close</div>'
    +'<div class="page-sub">Review the close summary below, then confirm your attestation to submit.</div>'
    +'<div style="background:#fff;border:.5px solid var(--moon3);border-radius:10px;padding:12px 14px;margin-bottom:14px">'
    +'<div style="font-size:10px;font-weight:700;color:var(--ocean);text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px">Close summary</div>'
    +summaryRows.map((r,i)=>'<div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;padding:5px 0;border-bottom:'+(i<summaryRows.length-1?'.5px solid var(--moon3)':'none')+'"><span style="color:var(--olive)">'+r[0]+'</span><span style="font-weight:700;color:'+r[2]+'">'+r[1]+'</span></div>').join('')
    +'</div>'
    +'<div class="attest-box">'
    +'<div style="font-size:13px;font-weight:700;color:var(--mid);margin-bottom:10px">General Manager Attestation</div>'
    +'<label class="attest-check-row" for="att-chk">'
    +'<input type="checkbox" id="att-chk" '+(attChecked?'checked':'')+' onchange="attChecked=this.checked;render()">'
    +'<span class="attest-check-label">I have reviewed and confirm the accuracy of this close for Edgewater, August 2026.</span>'
    +'</label>'
    +'<div class="attest-hint">ℹ️ By clicking Submit, your session credentials and timestamp will be recorded and attached to this close report for audit trail purposes.</div>'
    +'</div>'
    +navRow('Submit close →',true,!attChecked)
    +'</div>';
}

// ── REPORT ──
function buildReport(){
  const now=new Date();
  const ts=now.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})+' at '+now.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
  const arIt=RES.filter(r=>r.ar0+r.ar30+r.ar60+r.ar90>0).sort((a,b)=>{const p=x=>x.ar90>0?0:x.ar60>0?1:x.ar30>0?2:3;return p(a)-p(b);});
  const totAR=arIt.reduce((s,r)=>s+r.ar0+r.ar30+r.ar60+r.ar90,0);
  const arRows=arIt.map(r=>{
    const t=r.ar0+r.ar30+r.ar60+r.ar90,ag=r.ar90>0?'90+':r.ar60>0?'61–90':r.ar30>0?'31–60':'0–30';
    return '<div class="report-row"><span style="color:var(--olive)">'+r.name+' <span style="font-size:10px">('+ag+')</span></span>'
      +'<span style="display:flex;gap:8px;align-items:center"><span style="font-size:10px;color:var(--olive);font-style:italic;max-width:95px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+(arN[r.id]||'—')+'</span>'
      +'<span style="font-weight:700;'+((r.ar60+r.ar90)>0?'color:var(--roots)':'')+'">'+fmt(t)+'</span></span></div>';
  }).join('');
  const crIt=RES.filter(r=>r.credit>0),totCr=crIt.filter(r=>!crFlagged[r.id]).reduce((s,r)=>s+r.credit,0);
  const crRows=crIt.map(r=>'<div class="report-row"><span style="color:var(--olive)">'+r.name+(CF[r.id]&&r.credit>=500?' ⚠':'')+'</span>'
    +'<span style="display:flex;gap:8px;align-items:center">'
    +(crFlagNotes[r.id]?'<span style="font-size:10px;font-style:italic;color:var(--olive);max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+crFlagNotes[r.id]+'</span>':'')
    +'<span style="font-size:10px;font-weight:700;'+(crFlagged[r.id]?'color:#856404':'color:#155724')+'">'+(crFlagged[r.id]?'⚑ Flagged':'✓ Converted')+'</span>'
    +'<span style="font-weight:700">'+fmt(r.credit)+'</span></span></div>').join('');
  const ppEx=RES.filter(r=>r.prepay>0&&r.credit===0),ppCv=RES.filter(r=>r.credit>0&&!crFlagged[r.id]);
  const totPP=ppEx.reduce((s,r)=>s+r.prepay,0)+ppCv.reduce((s,r)=>s+r.credit,0);
  const ppRows=[
    ...ppCv.map(r=>'<div class="report-row"><span style="color:var(--olive)">'+r.name+' <span style="font-size:10px;color:var(--ocean)">(from credit)</span></span><span style="font-weight:700;color:#155724">'+fmt(r.credit)+'</span></div>'),
    ...ppEx.map(r=>'<div class="report-row"><span style="color:var(--olive)">'+r.name+' <span style="font-size:10px">(existing)</span></span><span style="font-weight:700">'+fmt(r.prepay)+'</span></div>'),
  ].join('');
  const woRows=MO.map(r=>{const dec=woD[r.id];
    return '<div class="report-row"><span style="color:var(--olive)">'+r.name+' <span style="font-size:10px">('+r.moDate+')</span></span>'
      +'<span style="display:flex;gap:8px;align-items:center">'+(dec===false&&woN[r.id]?'<span style="font-size:10px;color:var(--olive);font-style:italic;max-width:70px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+woN[r.id]+'</span>':'')
      +'<span style="font-size:10px;font-weight:700;'+(dec===true?'color:var(--roots)':dec===false?'color:var(--olive)':'color:var(--sun)')+'">'+(dec===true?'✓ Write-off':dec===false?'✗ Declined':'Pending')+'</span>'
      +'<span style="font-weight:700">'+fmt(r.total)+'</span></span></div>';
  }).join('');
  const totWO=MO.filter(r=>woD[r.id]===true).reduce((s,r)=>s+r.total,0);
  const allNotes=[];
  Object.entries(arN).filter(([k,v])=>v).forEach(([id,note])=>{const r=RES.find(x=>x.id===id);if(r)allNotes.push({who:r.name,ctx:'AR',note});});
  Object.entries(crFlagNotes).filter(([k,v])=>v).forEach(([id,note])=>{const r=RES.find(x=>x.id===id);if(r)allNotes.push({who:r.name,ctx:'Credit',note});});
  Object.entries(woN).filter(([k,v])=>v).forEach(([id,note])=>{const r=MO.find(x=>x.id===id);if(r)allNotes.push({who:r.name,ctx:'Write-off',note});});
  return '<div class="report-wrap">'
    +'<div class="report-hdr">'
    +'<div style="display:flex;align-items:flex-start;justify-content:space-between">'
    +'<div><div style="font-size:14px;font-weight:700;color:var(--moon)">AME Close Report</div>'
    +'<div style="font-size:12px;color:var(--moon3);margin-top:2px">August 2026 · Edgewater</div></div>'
    +'<span style="font-size:24px">📋</span></div>'
    +'<div style="background:rgba(255,255,255,.08);border-radius:8px;padding:9px 12px;margin-top:10px;display:flex;align-items:center;gap:10px">'
    +'<div style="font-size:20px">✅</div>'
    +'<div><div style="font-size:11px;font-weight:700;color:var(--moon)">General Manager attested</div>'
    +'<div style="font-size:10px;color:var(--moon3)">Submitted '+ts+' · Session credentials on file</div></div>'
    +'</div></div>'
    +'<div class="report-section"><div class="report-section-title">1 · AR outstanding</div>'+arRows
    +'<div class="report-row" style="margin-top:5px;border-top:.5px solid var(--moon3);padding-top:7px"><b>Total AR</b><span style="font-weight:700;color:var(--roots)">'+fmt(totAR)+'</span></div></div>'
    +'<div class="report-section"><div class="report-section-title">2 · Credits reviewed</div>'+crRows
    +'<div class="report-row" style="margin-top:5px;border-top:.5px solid var(--moon3);padding-top:7px"><b>Converted to prepayments</b><span style="font-weight:700;color:var(--ocean)">'+fmt(totCr)+'</span></div></div>'
    +'<div class="report-section"><div class="report-section-title">3 · Prepayments rolling over</div>'+ppRows
    +'<div class="report-row" style="margin-top:5px;border-top:.5px solid var(--moon3);padding-top:7px"><b>Total prepayments</b><span style="font-weight:700;color:#155724">'+fmt(totPP)+'</span></div></div>'
    +'<div class="report-section"><div class="report-section-title">4 · Write-offs</div>'+woRows
    +'<div class="report-row" style="margin-top:5px;border-top:.5px solid var(--moon3);padding-top:7px"><b>To Bad Debt GL</b><span style="font-weight:700;color:var(--roots)">'+fmt(totWO)+'</span></div></div>'
    +'<div class="report-section"><div class="report-section-title">5 · GM notes entered during close</div>'
    +(allNotes.length>0?allNotes.map(n=>'<div class="report-row"><span style="color:var(--olive)">'+n.who+' <span style="font-size:10px">('+n.ctx+')</span></span><span style="font-size:11px;font-style:italic;color:var(--mid);max-width:55%;text-align:right">'+n.note+'</span></div>').join('')
      :'<div style="font-size:11px;color:var(--moon3);padding:4px 0">No notes entered during this close.</div>')
    +'</div>'
    +'<div class="report-total"><span>Total AR outstanding</span><span style="color:var(--roots)">'+fmt(totAR)+'</span></div>'
    +'</div>';
}

// ── DONE ──
function donePage(){
  const allSent=['ctrl','asset','reteam'].every(id=>notif[id]);
  const team=[{i:'CT',n:'Controller · Accounting',id:'ctrl'},{i:'AM',n:'Asset Manager',id:'asset'},{i:'RT',n:'Real Estate Team',id:'reteam'}];
  const nRows=team.map(t=>'<div class="notif-row"><div class="notif-av">'+t.i+'</div><div style="flex:1"><div style="font-size:12px;font-weight:700;color:var(--mid)">'+t.n+'</div></div>'+(notif[t.id]?'<span class="sent-b">✓ Sent</span>':'<span class="pend-b">Pending</span>')+'</div>').join('');
  return '<div>'
    +'<div style="text-align:center;padding:1.5rem 1rem 1rem">'
    +'<div style="font-size:46px;color:var(--ocean);margin-bottom:10px">✓</div>'
    +'<div style="font-size:22px;font-weight:700;color:var(--mid);margin-bottom:3px">Close submitted</div>'
    +'<div style="font-size:13px;color:var(--olive)">August 2026 · All 5 steps complete · GM attested</div>'
    +'</div>'
    +'<div style="background:var(--moon);border:.5px solid var(--moon3);border-radius:12px;padding:16px;margin-bottom:12px">'
    +'<div class="eyebrow" style="margin-bottom:6px">Send close notification</div>'
    +'<div style="font-size:12px;color:var(--olive);margin-bottom:12px">Notify your team and generate the close summary report.</div>'
    +'<div class="tbl-wrap" style="margin-bottom:0">'+nRows+'</div>'
    +'<button class="cta-btn cta-sun" style="margin-top:12px" onclick="[\'ctrl\',\'asset\',\'reteam\'].forEach(id=>notif[id]=true);render()" '+(allSent?'disabled':'')+'>'+(allSent?'✓ Notifications sent':'Send notifications to all')+'</button>'
    +'</div>'
    +(allSent?buildReport():'')
    +'<button class="cta-btn cta-dark" onclick="resetAME()" style="margin-top:8px">↺ Start new close</button>'
    +'</div>';
}

function saveAdj(rid){
  const c=document.getElementById('ac-'+rid),a=document.getElementById('aa-'+rid);
  if(!a||!a.value.trim())return;
  const m=document.getElementById('am-'+rid);
  if(m){m.textContent='Saved: '+c.value+' '+fmt(parseFloat(a.value));m.style.display='block';}
}

// ── RENDER ──
function render(){
  const inWorkflow=step!=='start'&&step!=='done'&&step!=='paused';
  const showTotals=inWorkflow;
  let inner,tb;

  if(step==='paused'){
    tb=topBar(false);
    inner=pausedScreen();
  } else if(step==='start'){
    tb=topBar(false);
    inner=startPage();
  } else if(step==='done'){
    tb=topBar(false);
    inner=donePage();
  } else {
    tb=topBar(true); // show pause + deadline
    if(step==='ar') inner=arPage();
    else if(step==='credits') inner=crPage();
    else if(step==='prepay') inner=ppPage();
    else if(step==='writeoff') inner=woPage();
    else if(step==='attest') inner=attestPage();
    else inner='';
  }

  document.getElementById('app').innerHTML=
    tb
    +(showTotals?totalsBar():'')
    +(inWorkflow?'<div class="steps-track">'+pips(step)+'</div>':'')
    +'<div style="padding-bottom:40px">'+inner+'</div>';

  // Update deadline chip every minute
  if(deadlineInterval) clearInterval(deadlineInterval);
  if(inWorkflow){
    deadlineInterval=setInterval(()=>{
      const chip=document.querySelector('.deadline-chip');
      if(chip){const ds=getDeadlineState();chip.className='deadline-chip '+ds.cls;chip.innerHTML=(ds.cls==='ok'?'🕐':ds.cls==='warn'?'⚠️':'🔴')+' Due '+DEADLINE.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});}
    },60000);
  }
}
render();
</script>
