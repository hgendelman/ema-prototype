<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flow AME Demo v5</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Poppins',sans-serif;background:#e8e0d0;min-height:100vh;display:flex;justify-content:center;padding:20px 16px 60px}
.wrap{width:100%;max-width:480px}
:root{--mid:#3D3D3D;--moon:#F4EDDD;--sun:#F3941E;--ocean:#6DAEBC;--roots:#95421F;--olive:#75742F;--moon3:#D5CCBA}
.topbar{background:var(--mid);border-radius:10px;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:8px}
.top-left{display:flex;align-items:center;gap:8px;flex:1;min-width:0}
.top-right{display:flex;align-items:center;gap:8px;flex-shrink:0}
.top-month{font-size:12px;color:var(--moon3);white-space:nowrap}
.top-chip{font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;background:#4a5568;color:var(--moon3);white-space:nowrap}
/* Deadline chip */
.deadline-chip{font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;display:flex;align-items:center;gap:4px}
.deadline-chip.ok{background:#1a3a2a;color:#6fcf97}
.deadline-chip.warn{background:#4a3000;color:#fcd68a}
.deadline-chip.urgent{background:#4a1010;color:#f8a4a4}
/* Pause button */
.pause-btn{font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;cursor:pointer;background:transparent;border:1px solid #666;color:var(--moon3);font-family:'Poppins',sans-serif;white-space:nowrap;flex-shrink:0}
.pause-btn:hover{border-color:var(--moon3)}
/* Resume nudge banner */
.nudge-banner{background:var(--mid);border-radius:10px;padding:12px 14px;margin-bottom:12px;border-left:3px solid var(--sun);display:flex;align-items:center;justify-content:space-between;gap:10px}
.nudge-text{font-size:12px;color:var(--moon);flex:1;min-width:0}
.nudge-step{font-size:10px;color:var(--moon3);margin-top:2px}
.nudge-resume{font-size:11px;font-weight:700;padding:5px 14px;border-radius:8px;cursor:pointer;background:var(--sun);border:none;color:var(--mid);font-family:'Poppins',sans-serif;white-space:nowrap;flex-shrink:0}
/* Paused overlay */
.paused-screen{background:var(--moon);border-radius:12px;padding:28px 20px;text-align:center;margin-bottom:14px;border:.5px solid var(--moon3)}
/* Totals bar */
.totals-bar{background:var(--mid);border-radius:10px;padding:9px 14px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:6px}
.tot-item{text-align:center;flex:1}
.tot-lbl{font-size:9px;color:var(--moon3);font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px}
.tot-val{font-size:13px;font-weight:700}
.tot-val.red{color:#f8a4a4}.tot-val.amber{color:#fcd68a}.tot-val.teal{color:#90d4e0}.tot-val.white{color:#fff}
.tot-div{width:1px;height:28px;background:#555;flex-shrink:0}
.steps-track{display:flex;gap:5px;margin-bottom:16px}
.pip{flex:1;height:4px;border-radius:2px;background:#555}
.pip.done{background:var(--ocean)}.pip.active{background:var(--sun)}
.eyebrow{font-size:11px;font-weight:700;color:var(--ocean);letter-spacing:.07em;text-transform:uppercase;margin-bottom:5px}
.page-title{font-size:18px;font-weight:700;color:var(--mid);margin-bottom:4px}
.page-sub{font-size:12px;color:var(--olive);line-height:1.6;margin-bottom:14px}
.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px}
.stat{background:#fff;border-radius:10px;padding:.6rem .9rem;border:.5px solid var(--moon3)}
.stat-lbl{font-size:11px;color:var(--olive);margin-bottom:2px}
.stat-val{font-size:20px;font-weight:700;color:var(--mid)}
.stat-val.warn{color:var(--roots)}.stat-val.hi{color:var(--sun)}.stat-val.ok{color:var(--ocean)}
.tbl-wrap{background:#fff;border-radius:10px;border:.5px solid var(--moon3);overflow:hidden;margin-bottom:12px}
.tbl-head{background:var(--mid);padding:7px 12px;display:flex;align-items:center;gap:0}
.th{font-size:10px;font-weight:700;color:var(--moon);text-transform:uppercase;letter-spacing:.04em;flex-shrink:0;padding-right:4px}
.tbl-row{display:flex;align-items:center;padding:9px 12px;border-bottom:.5px solid var(--moon3);gap:0}
.tbl-row:nth-child(even){background:var(--moon)}.tbl-row:nth-child(odd){background:#fff}.tbl-row:last-child{border-bottom:none}
.pri-row{border-left:3px solid var(--roots)}
.c-res{flex:0 0 105px;min-width:0;padding-right:6px}
.c-res50{flex:0 0 95px;min-width:0;padding-right:6px}
.res-name{font-size:12px;font-weight:700;color:var(--mid);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.res-sub{font-size:10px;color:var(--olive);display:block;margin-top:1px}
.c-amt{width:42px;flex-shrink:0;font-size:11px;font-weight:700;text-align:right;padding-right:6px}
.c-amt.danger{color:var(--roots)}.c-amt.warn{color:var(--sun)}.c-amt.ok{color:#155724}
.c-note{flex:1;min-width:0}
.c-cr-amt{width:52px;flex-shrink:0;font-size:11px;font-weight:700;text-align:right;padding-right:6px}
.c-cr-amt.danger{color:var(--roots)}.c-cr-amt.ok{color:#155724}
.c-waves{flex:0 0 85px;min-width:0;padding-right:6px;font-size:10px;color:var(--roots);font-style:italic;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.35}
.c-cr-note{flex:1;min-width:0;padding-right:6px}
.c-actions{display:flex;align-items:center;gap:4px;flex-shrink:0}
.c-pp-amt{width:54px;flex-shrink:0;font-size:11px;font-weight:700;text-align:right;color:#155724;padding-right:6px}
.c-pp-note{flex:1;min-width:0;font-size:11px;color:var(--olive);font-style:italic;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.35;padding-right:6px}
.note-inp{width:100%;font-size:11px;padding:4px 7px;border-radius:6px;border:.5px solid var(--moon3);background:#fff;color:var(--mid);font-family:'Poppins',sans-serif;height:27px}
.note-inp:focus{outline:none;border-color:var(--ocean)}.note-inp.filled{border-color:var(--ocean);background:#f7fbfd}
.badge{display:inline-block;font-size:9px;padding:2px 7px;border-radius:20px;font-weight:700;white-space:nowrap}
.b-cur{background:#d4edda;color:#155724}.b-ev{background:#f8d7da;color:#721c24}.b-ntv{background:#d1ecf1;color:#0c5460}.b-mo{background:#f8d7da;color:#721c24}
.cta-btn{width:100%;padding:12px;font-size:14px;font-weight:700;cursor:pointer;border:none;border-radius:10px;font-family:'Poppins',sans-serif;margin-top:6px}
.cta-sun{background:var(--sun);color:var(--mid)}.cta-dark{background:var(--mid);color:var(--moon)}
.cta-sun:disabled{opacity:.4;cursor:not-allowed}
.back-btn{background:transparent;border:.5px solid var(--moon3);color:var(--olive);font-size:12px;font-weight:600;padding:9px 16px;border-radius:8px;cursor:pointer;font-family:'Poppins',sans-serif;flex-shrink:0}
.nav-row{display:flex;gap:8px;margin-top:6px;align-items:stretch}
.nav-row .cta-btn{margin-top:0;flex:1}
.flag-btn{font-size:10px;padding:3px 8px;border-radius:6px;cursor:pointer;background:transparent;border:.5px solid #856404;color:#856404;font-family:'Poppins',sans-serif;white-space:nowrap}
.unflag-btn{font-size:10px;padding:3px 8px;border-radius:6px;cursor:pointer;background:#fff3cd;border:.5px solid #856404;color:#856404;font-family:'Poppins',sans-serif;white-space:nowrap}
.ledger-btn{font-size:10px;padding:3px 8px;border-radius:6px;cursor:pointer;background:transparent;border:.5px solid var(--ocean);color:var(--ocean);font-family:'Poppins',sans-serif;white-space:nowrap}
.flagged-chip{font-size:9px;padding:2px 6px;border-radius:20px;background:#fff3cd;color:#856404;font-weight:700;white-space:nowrap}
.bottom-action-box{background:var(--moon);border:.5px solid var(--moon3);border-radius:10px;padding:14px;margin-bottom:8px}
.bottom-action-title{font-size:12px;font-weight:700;color:var(--mid);margin-bottom:4px}
.bottom-action-sub{font-size:11px;color:var(--olive);line-height:1.5;margin-bottom:10px}
.wo-bd{background:#fdf9f4;border-top:.5px solid var(--moon3);padding:8px 12px}
.wo-bd-row{display:flex;justify-content:space-between;font-size:11px;color:var(--mid);padding:3px 0;border-bottom:.5px solid var(--moon3)}
.wo-bd-row:last-child{border-bottom:none;font-weight:700;color:var(--roots)}
.wo-yes{padding:4px 12px;border-radius:7px;background:#d4edda;color:#155724;border:none;font-size:11px;font-weight:700;cursor:pointer;font-family:'Poppins',sans-serif}
.wo-no{padding:4px 12px;border-radius:7px;background:#f8d7da;color:#721c24;border:none;font-size:11px;font-weight:700;cursor:pointer;font-family:'Poppins',sans-serif}
.wo-decided{font-size:11px;font-weight:700;padding:3px 10px;border-radius:6px}
.wo-decided.yes{background:#d4edda;color:#155724}.wo-decided.no{background:#f8d7da;color:#721c24}
.wo-no-note{padding:8px 12px;border-top:.5px solid var(--moon3);background:#fff}
.wo-no-note input{width:100%;font-size:11px;padding:5px 8px;border-radius:6px;border:.5px solid var(--moon3);background:#fdf9f4;color:var(--mid);font-family:'Poppins',sans-serif;height:27px}
.undo-btn{font-size:10px;padding:3px 7px;border-radius:5px;cursor:pointer;background:transparent;border:.5px solid var(--moon3);color:var(--olive);font-family:'Poppins',sans-serif}
.overlay-wrap{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(61,61,61,.6);display:flex;align-items:flex-start;justify-content:center;padding-top:50px;z-index:100}
.modal{background:var(--moon);border-radius:12px;width:92%;max-width:430px;border:.5px solid var(--moon3);overflow:hidden;max-height:86vh;overflow-y:auto}
.modal-hdr{background:var(--mid);padding:10px 14px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0}
.modal-title{font-size:12px;font-weight:700;color:var(--moon)}
.modal-close{background:transparent;border:none;color:var(--moon);font-size:20px;cursor:pointer;line-height:1}
.modal-body{padding:12px 14px}
.ledger-tbl{width:100%;font-size:11px;border-collapse:collapse;table-layout:fixed}
.ledger-tbl th{background:var(--mid);color:var(--moon);padding:5px 6px;text-align:left;font-weight:700}
.ledger-tbl td{padding:5px 6px;border-bottom:.5px solid var(--moon3);color:var(--mid)}
.ledger-tbl tr:nth-child(odd) td{background:#fff}.ledger-tbl tr:nth-child(even) td{background:var(--moon)}
.adj-row{display:flex;gap:6px;margin-top:10px}
.adj-row select,.adj-row input{font-size:11px;padding:5px 7px;border-radius:6px;border:.5px solid var(--moon3);background:#fff;color:var(--mid);font-family:'Poppins',sans-serif}
.adj-save{padding:6px 12px;background:var(--sun);border:none;border-radius:6px;font-size:11px;font-weight:700;color:var(--mid);cursor:pointer;font-family:'Poppins',sans-serif;white-space:nowrap}
.notif-row{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:.5px solid var(--moon3)}
.notif-row:last-child{border-bottom:none}
.notif-av{width:32px;height:32px;border-radius:50%;background:var(--ocean);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.sent-b{font-size:10px;padding:3px 8px;border-radius:20px;background:#d4edda;color:#155724;font-weight:700}
.pend-b{font-size:10px;padding:3px 8px;border-radius:20px;background:#fff3cd;color:#856404;font-weight:700}
.attest-box{background:var(--moon);border:1.5px solid var(--ocean);border-radius:12px;padding:18px;margin-bottom:12px}
.attest-check-row{display:flex;align-items:flex-start;gap:11px;padding:14px;background:#fff;border-radius:9px;border:.5px solid var(--moon3);cursor:pointer}
.attest-check-row input[type=checkbox]{margin-top:2px;width:17px;height:17px;flex-shrink:0;accent-color:var(--ocean);cursor:pointer}
.attest-check-label{font-size:12px;color:var(--mid);font-weight:600;line-height:1.55;cursor:pointer}
.attest-hint{font-size:11px;color:var(--olive);line-height:1.6;margin-top:10px;padding:10px 12px;background:#f0f8fa;border-radius:8px;border:.5px solid var(--ocean)}
.report-wrap{background:#fff;border-radius:10px;border:.5px solid var(--moon3);overflow:hidden;margin-top:12px}
.report-hdr{background:var(--mid);padding:12px 14px}
.report-section{padding:11px 14px;border-bottom:.5px solid var(--moon3)}
.report-section:last-child{border-bottom:none}
.report-section-title{font-size:10px;font-weight:700;color:var(--ocean);text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
.report-row{display:flex;justify-content:space-between;align-items:baseline;padding:5px 0;border-bottom:.5px solid var(--moon3);font-size:11px}
.report-row:last-child{border-bottom:none}
.report-total{display:flex;justify-content:space-between;padding:8px 14px;background:var(--moon);font-size:12px;font-weight:700;color:var(--mid);border-top:.5px solid var(--moon3)}
</style>
</head>
<body>
<div class="wrap"><div id="app"></div></div>
<script>
// ── LOGOS (injected at build time) ──
const LC='';
const LD='';

const RES=[
  {id:'r02',name:'James Whitfield',unit:'104',status:'Current',ar0:285,ar30:0,ar60:0,ar90:0,credit:0,prepay:620,prepayNote:'Prepaid rent Aug 5 via ACH — reflects Sept advance.'},
  {id:'r03',name:'Sandra Okonkwo',unit:'108',status:'Current',ar0:0,ar30:0,ar60:0,ar90:0,credit:750,prepay:0,prepayNote:'Move-in concession applied Aug 1.'},
  {id:'r04',name:'Derek Pham',unit:'112',status:'Current',ar0:0,ar30:520,ar60:0,ar90:0,credit:0,prepay:0,prepayNote:''},
  {id:'r05',name:'Latoya Simmons',unit:'201',status:'Current',ar0:0,ar30:0,ar60:1140,ar90:0,credit:0,prepay:450,prepayNote:'Overpaid Jul rent $450 — held as prepayment per GM approval.'},
  {id:'r06',name:'Robert Crane',unit:'205',status:'Under Eviction',ar0:0,ar30:0,ar60:875,ar90:0,credit:2000,prepay:0,prepayNote:''},
  {id:'r07',name:'Amina Hassan',unit:'210',status:'Current',ar0:0,ar30:0,ar60:0,ar90:0,credit:95,prepay:0,prepayNote:'Late fee $95 reversed Aug 10 per manager approval.'},
  {id:'r08',name:'Curtis Bellamy',unit:'214',status:'Notice to Vacate',ar0:0,ar30:0,ar60:0,ar90:2350,credit:0,prepay:1200,prepayNote:'Double rent paid Jul — $1,200 held as prepayment.'},
  {id:'r09',name:'Priya Nair',unit:'218',status:'Under Eviction',ar0:0,ar30:0,ar60:0,ar90:1870,credit:580,prepay:0,prepayNote:''},
  {id:'r10',name:'Thomas Garza',unit:'302',status:'Current',ar0:0,ar30:430,ar60:0,ar90:0,credit:0,prepay:0,prepayNote:''},
  {id:'r11',name:'Elena Vasquez',unit:'305',status:'Current',ar0:0,ar30:680,ar60:0,ar90:0,credit:0,prepay:0,prepayNote:''},
  {id:'r12',name:'Marcus Reid',unit:'310',status:'Current',ar0:0,ar30:295,ar60:0,ar90:0,credit:0,prepay:0,prepayNote:''},
];
const MO=[
  {id:'m01',name:'Evelyn Brooks',moDate:'Jun 2026',total:1650,bd:[{l:'Rent',a:1000},{l:'Parking',a:150},{l:'Utility recovery',a:350},{l:'Cleaning fee',a:150}]},
  {id:'m02',name:'Marcus Webb',moDate:'Jul 2026',total:920,bd:[{l:'Rent',a:700},{l:'Pet damage',a:120},{l:'Late fees',a:100}]},
  {id:'m03',name:'Diana Reyes',moDate:'May 2026',total:340,bd:[{l:'Rent',a:280},{l:'Utility recovery',a:60}]},
];
const LED={
  r06:[{d:'08/01',desc:'Rent charge',c:'RNT',a:2100},{d:'08/05',desc:'Late fee',c:'LTF',a:150},{d:'08/10',desc:'LTF reversal',c:'LTF-REV',a:-150},{d:'08/15',desc:'LTF reversal',c:'LTF-REV',a:-150},{d:'08/20',desc:'Rent payment',c:'PMT',a:-2100},{d:'08/22',desc:'Concession rev.',c:'CON-REV',a:-1700}],
  r09:[{d:'08/01',desc:'Rent charge',c:'RNT',a:1950},{d:'08/12',desc:'Pet fee',c:'PET',a:75},{d:'08/18',desc:'Credit adj.',c:'CR-ADJ',a:-580},{d:'08/25',desc:'Partial payment',c:'PMT',a:-1370}],
  r05:[{d:'07/01',desc:'Rent charge',c:'RNT',a:1600},{d:'07/02',desc:'Overpayment',c:'PMT',a:-2050},{d:'08/01',desc:'Rent charge',c:'RNT',a:1600},{d:'08/15',desc:'Partial pmt',c:'PMT',a:-460}],
  r03:[{d:'08/01',desc:'Rent charge',c:'RNT',a:1800},{d:'08/03',desc:'Concession',c:'CON',a:-750},{d:'08/15',desc:'Rent payment',c:'PMT',a:-1800}],
};
const CF={
  r06:'Waves: 2 LTF reversals + large concession reversal. Unusual.',
  r09:'Waves: $580 credit adj. — confirm alignment.',
  r03:'Waves: $750 concession — move-in special. Normal.',
  r07:'Waves: $95 LTF reversal. Normal.',
};
const CODES=['RNT','LTF','LTF-REV','PMT','CON','CON-REV','CR-ADJ','PET','NSF','PARK','UTIL'];
const STEPS=['ar','credits','prepay','writeoff','attest'];
const STEP_LABELS={'ar':'Step 1 · AR review','credits':'Step 2 · Credits','prepay':'Step 3 · Prepayments','writeoff':'Step 4 · Write-offs','attest':'Step 5 · Attestation'};

// Deadline: midnight tonight (configurable — accounting sets this)
const DEADLINE = new Date();
DEADLINE.setHours(23,59,0,0);

// State
let step='start', paused=false, pausedAt=null;
let arN={},crFlagged={},crFlagNotes={},woD={},woN={},led=null,notif={};
let attChecked=false;
let deadlineInterval=null;

const $=s=>document.getElementById(s);
const fmt=n=>'$'+Math.abs(n).toLocaleString();

function bdg(s){
  const m={'Current':'b-cur','Under Eviction':'b-ev','Notice to Vacate':'b-ntv','Moved Out':'b-mo'};
  const l={'Current':'Current','Under Eviction':'Eviction','Notice to Vacate':'NTV','Moved Out':'Moved out'};
  return '<span class="badge '+(m[s]||'')+'>'+(l[s]||s)+'</span>';
}
function pips(c){return STEPS.map(s=>'<div class="pip '+(c===s?'active':STEPS.indexOf(c)>STEPS.indexOf(s)?'done':'')+'"></div>').join('');}
function srtAR(r){return[...r].filter(x=>x.ar0+x.ar30+x.ar60+x.ar90>0).sort((a,b)=>{const p=x=>x.ar90>0?0:x.ar60>0?1:x.ar30>0?2:3;return p(a)!==p(b)?p(a)-p(b):(b.ar90+b.ar60+b.ar30+b.ar0)-(a.ar90+a.ar60+a.ar30+a.ar0);});}
function back(){const i=STEPS.indexOf(step);if(i>0){led=null;step=STEPS[i-1];render();}}
function fwd(){led=null;const i=STEPS.indexOf(step);step=i<STEPS.length-1?STEPS[i+1]:'done';render();}

// ── DEADLINE LOGIC ──
function getDeadlineState(){
  const now=new Date(), diff=DEADLINE-now;
  if(diff<=0) return{label:'Overdue',cls:'urgent',mins:0};
  const mins=Math.floor(diff/60000);
  const hrs=Math.floor(mins/60), rm=mins%60;
  const label=hrs>0?(hrs+'h '+(rm>0?rm+'m ':'')+' left'):(mins+'m left');
  if(mins<=30) return{label,cls:'urgent',mins};
  if(mins<=120) return{label,cls:'warn',mins};
  return{label,cls:'ok',mins};
}

function deadlineChip(){
  const ds=getDeadlineState();
  const icon=ds.cls==='ok'?'🕐':ds.cls==='warn'?'⚠️':'🔴';
  return '<span class="deadline-chip '+ds.cls+'">'+icon+' Due '+DEADLINE.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})+'</span>';
}

// ── PAUSE / RESUME ──
function pauseAME(){
  paused=true;
  pausedAt=step;
  step='paused';
  render();
}
function resumeAME(){
  paused=false;
  step=pausedAt||'ar';
  render();
}
function resetAME(){
  step='start';paused=false;pausedAt=null;
  arN={};crFlagged={};crFlagNotes={};woD={};woN={};led=null;notif={};attChecked=false;
  render();
}

// ── TOTALS BAR ──
function totalsBar(){
  const totAR=RES.reduce((s,r)=>s+r.ar0+r.ar30+r.ar60+r.ar90,0);
  const totCr=RES.filter(r=>r.credit>0&&!crFlagged[r.id]).reduce((s,r)=>s+r.credit,0);
  const totPP=RES.filter(r=>r.prepay>0&&r.credit===0).reduce((s,r)=>s+r.prepay,0)+totCr;
  const totWO=MO.filter(r=>woD[r.id]===true).reduce((s,r)=>s+r.total,0);
  return '<div class="totals-bar">'
    +'<div class="tot-item"><div class="tot-lbl">AR</div><div class="tot-val red">'+fmt(totAR)+'</div></div><div class="tot-div"></div>'
